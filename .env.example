# Copy to .env and fill in your values

# Required — OpenRouter API key (get one at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-...

# Model to use for the main ReAct agent loop
# Default: claude-sonnet for best text-to-SQL accuracy
# Cheaper alternative: google/gemini-2.0-flash-001
GROUNDEDSQL_MODEL=anthropic/claude-sonnet-4-5

# Model used for the bulk eval run (50–100 questions) — use something cheap
GROUNDEDSQL_EVAL_MODEL=google/gemini-2.0-flash

# Optional — Langfuse observability (leave blank to run without tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
